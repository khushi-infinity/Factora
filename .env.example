# Factora — environment template
#
# Copy to .env at the REPOSITORY ROOT and fill in with YOUR OWN values:
#     cp .env.example .env
#
# The FastAPI backend reads this file (backend/app/config.py). The Vite frontend does NOT read it —
# see frontend/.env.example for the two optional frontend overrides.
#
# ⚠️  .env is gitignored and must NEVER be committed (AGENTS.md rule 4).
# ⚠️  This file contains placeholders only — no real account ids, users, keys or tokens.
# ⚠️  Prefer key-pair authentication over passwords.
# ⚠️  Use a read-mostly role at runtime; never put ACCOUNTADMIN in app config.

# ───────────────────────── Backend (FastAPI) ─────────────────────────
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API directly. In development the Vite proxy
# means the browser never needs CORS, but keep this for direct calls and future deployments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend dev server (documentation only — configured in frontend/vite.config.ts)
# http://localhost:5173

# ───────────────────────────── Demo behaviour ─────────────────────────#   live  = always query Snowflake
#   cache = prefer persisted rows / snapshot, fall back to live for misses
#   demo  = cache-first + synthetic/labelled data allowed, never block the demo
# (The playbook calls the same switch FACTORA_DEMO_MODE; the backend field is DEMO_MODE.)
DEMO_MODE=live
DEMO_CACHE_MAX_AGE_SECONDS=900
DEMO_PRIMARY_MACHINE=CNC-03
DEMO_LINE=LINE-2

# ─────────────────────────── Snowflake ────────────────────────────
# Names follow the build playbook: database FACTORA, schemas RAW / CORE / AI / DOCS,
# warehouse FACTORA_WH (XSMALL, auto-suspend 60 s — created once by the human in Snowsight).
# Connection (the Snowflake CLI connection named `factora` should match these values)
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=FACTORA_APP_USER
SNOWFLAKE_ROLE=FACTORA_APP_ROLE
SNOWFLAKE_WAREHOUSE=FACTORA_WH
SNOWFLAKE_DATABASE=FACTORA
SNOWFLAKE_SCHEMA=CORE

# Authentication — choose ONE strategy and leave the other blank
# (a) key-pair (preferred): path to a local private key file that is gitignored
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/factora_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# (b) password (hackathon-account fallback only): never commit a real value
# SNOWFLAKE_PASSWORD=

# Optional tuning. The connectivity probe is TTL-cached so health polling cannot open a session
# per request; all values here are read-only with respect to Snowflake cost controls (AGENTS rule 7).
SNOWFLAKE_CLIENT_SESSION_KEEP_ALIVE=true
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=30
SNOWFLAKE_LOGIN_TIMEOUT_SECONDS=10
SNOWFLAKE_PROBE_TTL_SECONDS=30

# ───────────────────────────── Cortex / AI ───────────────────────────
# Verify the model is available in the hackathon account before demo day.
CORTEX_MODEL=mistral-large2
CORTEX_MAX_TOKENS=900
CORTEX_TEMPERATURE=0.2
CORTEX_SEARCH_SERVICE=FACTORA.AI.KNOWLEDGE_SEARCH
CORTEX_CITATION_LIMIT=5
# Set to `replay` to serve persisted AI_EXPLANATION rows instead of calling the model (offline-safe demo).
AI_EXPLANATION_MODE=live

# ─────────────────────── Demo dataset + seeding ──────────────────────
# Synthetic twin: >= 90 days of readings with a planted CNC-03 spindle-bearing signature.
SEED_MACHINE_COUNT=12
SEED_HISTORY_DAYS=90
SEED_READING_INTERVAL_MINUTES=15
SEED_CNC03_DEGRADATION_START_DAYS_AGO=45
SEED_RANDOM_SEED=20261002
SEED_RESET_BEFORE_LOAD=false

# ───────────────────────── Local ML artefacts ────────────────────────
# Where joblib models live. Build output: never committed (see .gitignore).
MODEL_ARTIFACT_DIR=backend/artifacts

# ───────────────────────── Python / Snowpark ─────────────────────────
PYTHONUNBUFFERED=1

# ──────────────────────────── Guardrails ─────────────────────────────
# Read-only by design. The app must NOT modify Snowflake cost-control settings (AGENTS.md rule 7).
COST_GUARDRAIL_READ_ONLY=true
COST_GUARDRAIL_WARN_CREDITS_PER_RUN=1.0
