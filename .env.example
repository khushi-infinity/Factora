# Factora — environment template
#
# Copy to .env and fill in with YOUR OWN values:
#     cp .env.example .env
#
# ⚠️  .env is gitignored and must NEVER be committed (AGENTS.md rule 4).
# ⚠️  This file contains placeholders only — no real account ids, users, keys or tokens.
# ⚠️  Prefer key-pair authentication over passwords.
# ⚠️  Use a read-mostly role at runtime; never put ACCOUNTADMIN in app config.

# ─────────────────────────────── App ───────────────────────────────
# Local web app (M5+). Keep the port free before starting; another dev server may hold 3000.
APP_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Demo behaviour (see PROJECT_SPEC.md §9 "Failure/fallback policy")
#   live  = always query Snowflake
#   cache = prefer persisted rows / snapshot, fall back to live for misses
#   demo  = cache-first + synthetic/labelled data allowed, never block the demo
DEMO_MODE=live
DEMO_CACHE_MAX_AGE_SECONDS=900

# ─────────────────────────── Snowflake ────────────────────────────
# Connection (Snowflake CLI connection name `factora` should match these values)
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=FACTORA_APP_USER
SNOWFLAKE_ROLE=FACTORA_APP_ROLE
SNOWFLAKE_WAREHOUSE=FACTORA_WH_XS
SNOWFLAKE_DATABASE=FACTORA_DEV
SNOWFLAKE_SCHEMA=ANALYTICS

# Authentication — choose ONE strategy and leave the other blank
# (a) key-pair (preferred): path to a local private key file that is gitignored
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/factora_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# (b) password (fallback for the hackathon account only): never commit a real value
# SNOWFLAKE_PASSWORD=
# Optional tuning
SNOWFLAKE_CLIENT_SESSION_KEEP_ALIVE=true
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=30

# ───────────────────────────── Cortex / AI ───────────────────────────
# Verify the model is available in the hackathon account before demo day.
CORTEX_MODEL=mistral-large2
CORTEX_MAX_TOKENS=900
CORTEX_TEMPERATURE=0.2
CORTEX_SEARCH_SERVICE=FACTORA_DEV.AI.KNOWLEDGE_SEARCH
CORTEX_CITATION_LIMIT=5
# Set to `replay` to serve persisted AI_EXPLANATION rows instead of calling the model (offline-safe demo).
AI_EXPLANATION_MODE=live

# ─────────────────────── Demo dataset + seeding ──────────────────────
# Synthetic twin: >= 90 days of readings with a planted CNC-03 spindle-bearing signature.
SEED_MACHINE_COUNT=12
SEED_HISTORY_DAYS=90
SEED_READING_INTERVAL_MINUTES=15
SEED_CNC03_DEGRADATION_START_DAYS_AGO=45
SEED_RANDOM_SEED=20261002
SEED_RESET_BEFORE_LOAD=false

# Demo anchor asset (PROJECT_SPEC.md §9) — display only; the CRITICAL state must come from the data.
DEMO_PRIMARY_MACHINE=CNC-03
DEMO_LINE=LINE-2

# ───────────────────────── Python / Snowpark ─────────────────────────
PYTHONUNBUFFERED=1

# ──────────────────────────── Guardrails ─────────────────────────────
# Read-only by design. The app must NOT modify Snowflake cost-control settings (AGENTS.md rule 7).
COST_GUARDRAIL_READ_ONLY=true
COST_GUARDRAIL_WARN_CREDITS_PER_RUN=1.0
