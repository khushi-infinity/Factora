# Factora frontend — optional overrides
#
# In development you normally need NOTHING here: the SPA calls `/api/*` on its own
# origin and Vite proxies that to FastAPI (see vite.config.ts → server.proxy).
#
# Copy to `.env.local` only if you need to point at a different API.
# ⚠️  Never put Snowflake credentials in the frontend — they belong in the repo-root
#     `.env`, which only the FastAPI backend reads (AGENTS.md rule 4).

# Absolute API base URL. Leave empty/unset to use the Vite dev proxy.
VITE_API_BASE_URL=

# Where the dev proxy forwards `/api` (read at config time, not by the browser).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
